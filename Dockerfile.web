# ============================================================
# Dockerfile Multi-stage para o Frontend Web (Vite + Nginx)
# ============================================================

# --- Etapa 1: Build do Frontend ---
FROM node:20-alpine AS build-stage

WORKDIR /app

# Copia dependências e instala todas (incluindo devDependencies para a build)
COPY package.json package-lock.json ./
RUN npm ci

# Copia código fonte do frontend
COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src

# Define variáveis de ambiente para a build de produção
ARG VITE_API_URL=/api
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_ALLOWED_DOMAIN

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_ALLOWED_DOMAIN=$VITE_GOOGLE_ALLOWED_DOMAIN

# Executa o build de produção (gera a pasta /app/dist)
RUN npm run build

# --- Etapa 2: Servidor Web Nginx ---
FROM nginx:alpine AS production-stage

# Remove a configuração padrão do Nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copia a nossa configuração customizada do Nginx
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Copia os arquivos compilados da etapa 1 para a pasta pública do Nginx
COPY --from=build-stage /app/dist /usr/share/nginx/html

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
