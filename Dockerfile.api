# ============================================================
# Dockerfile para o Backend API (Express + Node.js)
# ============================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copia manifestos de dependências
COPY package.json package-lock.json ./

# Instala dependências de produção
RUN npm ci --omit=dev

# Copia código do backend, scripts e migrações
COPY backend ./backend
COPY scripts ./scripts
COPY database ./database
COPY migrations ./migrations

# Expõe a porta interna da API (3000)
EXPOSE 3000

# Script de inicialização (roda migrações e inicia a API)
CMD ["sh", "-c", "node scripts/run-migrations.js && node backend/src/server.js"]
