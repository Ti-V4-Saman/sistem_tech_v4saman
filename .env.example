APP_ENV=development
APP_PORT=3000

# Frontend URL for CORS
VITE_API_URL=/api
VITE_ENABLE_MOCKS=false
CORS_ORIGIN=http://localhost:5173

# Organização padrão do sistema
DEFAULT_ORG_NAME="V4 Company"
DEFAULT_ORG_SLUG=v4company

# Google Login / Google Identity Services
# Use o Client ID OAuth 2.0 do tipo Web Application no Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=seu-client-id-google.apps.googleusercontent.com
GOOGLE_CLIENT_ID=seu-client-id-google.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=suaempresa.com.br
VITE_GOOGLE_ALLOWED_DOMAIN=suaempresa.com.br

# Banco próprio do TechHub - MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=techhub
# Opcional: mysql://root:password@localhost:3306/techhub
DATABASE_URL=

# Segurança
# Em produção, use valores longos e únicos. NUNCA versionar segredos reais.
JWT_SECRET=super_secret_jwt_key_example
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d
ENCRYPTION_KEY=super_secret_encryption_key_32_bytes_example

# Usuário inicial para seed
SEED_ADMIN_NAME="Admin TechHub"
SEED_ADMIN_EMAIL=admin@suaempresa.com.br
SEED_ADMIN_PASSWORD=troque-essa-senha
SEED_ADMIN_JOB_ROLE=gerente
SEED_ADMIN_TEAM=snipers

# Fontes externas (opcional para integrações externas)
N8N_DB_HOST=
N8N_DB_PORT=5432
N8N_DB_USER=
N8N_DB_PASSWORD=
N8N_DB_NAME=
N8N_BASE_URL=

TYPEBOT_DB_HOST=
TYPEBOT_DB_PORT=5432
TYPEBOT_DB_USER=
TYPEBOT_DB_PASSWORD=
TYPEBOT_DB_NAME=
TYPEBOT_VIEWER_BASE_URL=
TYPEBOT_EDITOR_BASE_URL=
