# ============================================================
# Configuração de Produção para DigitalOcean (techops.v4saman.com)
# Renomeie este arquivo para .env no seu servidor na DigitalOcean
# ============================================================

APP_ENV=production
APP_PORT=3000

# URL Base para o Frontend e CORS
CORS_ORIGIN=https://techops.v4saman.com
VITE_API_URL=/api

# Configurações do Banco de Dados MySQL (Docker interno)
DB_HOST=db
DB_PORT=3306
DB_USER=techops_user
DB_PASSWORD=TroqueEssaSenhaPorUmaSenhaSegura123!
DB_NAME=techhub

# Segredos de Criptografia e Autenticação (Altere para chaves aleatórias seguras!)
JWT_SECRET=super_secret_jwt_key_techops_v4saman_production_2026
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d
ENCRYPTION_KEY=super_secret_encryption_key_32bytes_v4saman

# Google Login / OAuth 2.0
GOOGLE_CLIENT_ID=seu-client-id-google.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=seu-client-id-google.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=v4company.net.br
VITE_GOOGLE_ALLOWED_DOMAIN=v4company.net.br

# Usuário Administrador Inicial (Seed)
SEED_ADMIN_NAME="Admin TechOps"
SEED_ADMIN_EMAIL=admin@v4saman.com
SEED_ADMIN_PASSWORD=SenhaAdminSegura123!
SEED_ADMIN_JOB_ROLE=gerente
SEED_ADMIN_TEAM=snipers
